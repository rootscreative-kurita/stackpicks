---
interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  publishDate: Date;
}

const { title, description, category, slug, publishDate } = Astro.props;
const dateStr = publishDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="article-card">
  <div class="article-card__body">
    <span class="article-card__category">{category}</span>
    <h2 class="article-card__title">
      <a href={`/articles/${slug}/`}>{title}</a>
    </h2>
    <p class="article-card__desc">{description}</p>
    <time class="article-card__meta" datetime={publishDate.toISOString()}>{dateStr}</time>
  </div>
</article>
