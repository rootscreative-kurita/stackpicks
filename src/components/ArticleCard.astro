---
interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
  publishDate: Date;
  heroImage?: string;
}

const { title, description, category, slug, publishDate, heroImage } = Astro.props;
const dateStr = publishDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="article-card">
  {heroImage && (
    <a href={`/articles/${slug}/`} class="article-card__img-link">
      <img src={heroImage} alt={title} class="article-card__img" loading="lazy" />
    </a>
  )}
  <div class="article-card__body">
    <span class="article-card__category">{category}</span>
    <h2 class="article-card__title">
      <a href={`/articles/${slug}/`}>{title}</a>
    </h2>
    <p class="article-card__desc">{description}</p>
    <time class="article-card__meta" datetime={publishDate.toISOString()}>{dateStr}</time>
  </div>
</article>
