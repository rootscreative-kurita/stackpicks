---
import BaseLayout from './BaseLayout.astro';
import AffiliateCTA from '../components/AffiliateCTA.astro';
import ArticleDisclaimer from '../components/ArticleDisclaimer.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  tags: string[];
  publishDate: Date;
  updateDate?: Date;
  affiliate?: Array<{ name: string; url: string; cta?: string }>;
}

const { title, description, category, tags, publishDate, updateDate, affiliate } = Astro.props;
const dateStr = publishDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const updateStr = updateDate?.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} type="article" publishDate={publishDate}>
  <div class="article-container">
    <header class="article-header">
      <span class="article-header__category">{category}</span>
      <h1 class="article-header__title">{title}</h1>
      <div class="article-header__dates">
        <span class="article-header__date">
          <span class="article-header__date-label">公開日</span>
          <time datetime={publishDate.toISOString()}>{dateStr}</time>
        </span>
        {updateDate && (
          <span class="article-header__date">
            <span class="article-header__date-label">最終更新</span>
            <time datetime={updateDate.toISOString()}>{updateStr}</time>
          </span>
        )}
      </div>
    </header>

    {affiliate && <AffiliateCTA affiliates={affiliate} />}

    <div class="article-body">
      <slot />
    </div>

    {affiliate && <AffiliateCTA affiliates={affiliate} />}

    <div style="margin-bottom: var(--sp-xl);">
      <ul class="tag-list">
        {tags.map(tag => <li class="tag">{tag}</li>)}
      </ul>
    </div>

    <ArticleDisclaimer publishDate={publishDate} updateDate={updateDate} />
  </div>
</BaseLayout>
